# Copy this file to `.env` and fill in the values you have.
# Any platform left empty is reported as "failed: not configured" — the others still post.

# General
REQUEST_TIMEOUT=15

# 1) Telegram — https://core.telegram.org/bots/api#sendmessage
#    Create a bot with @BotFather, add it as an admin of a PUBLIC channel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=@your_public_channel

# 2) Discord — https://discord.com/developers/docs/resources/webhook#execute-webhook
#    Server Settings > Integrations > Webhooks > New Webhook > Copy Webhook URL
DISCORD_WEBHOOK_URL=

# 3) Mastodon — https://docs.joinmastodon.org/methods/statuses/#create
#    Preferences > Development > New application (scope: write:statuses)
MASTODON_INSTANCE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=

# 4) Bluesky — https://docs.bsky.app/docs/advanced-guides/posts
#    Settings > Privacy and security > App passwords (never use your main password)
BLUESKY_SERVICE_URL=https://bsky.social
BLUESKY_HANDLE=yourname.bsky.social
BLUESKY_APP_PASSWORD=

# 5) GitHub Gist — https://docs.github.com/en/rest/gists/gists#create-a-gist
#    Settings > Developer settings > Personal access tokens (fine-grained, "Gists: write")
GITHUB_TOKEN=
